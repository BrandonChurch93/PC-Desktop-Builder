{
  "name": "desktop-pc-builder",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5310 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5311 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "npm run build && playwright test --project=chromium",
    "e2e:smoke": "npm run build && playwright test --project=webkit --project=firefox --grep @smoke",
    "e2e:all": "npm run build && playwright test --project=chromium && playwright test --project=webkit --project=firefox --grep @smoke",
    "shots": "node scripts/shots.mjs",
    "thumbs": "node scripts/thumbs.mjs",
    "verdict": "node scripts/verdict.mjs",
    "critic:list": "node scripts/critic-list.mjs",
    "check:shots": "node scripts/check-shots.mjs",
    "check:copy": "node scripts/check-copy.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/unbounded": "5.3.0",
    "gsap": "3.15.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.2.1",
    "playwright": "1.65.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
